# Maat public edge — terminates TLS (auto Let's Encrypt) for these hostnames:
#   • $MAAT_HOST        — PUBLIC. Serves ONLY the read API (/api/*). (api.maat.press)
#   • $MAAT_ADMIN_HOST  — the operator/admin console. Public *name* + real cert, but served
#                          ONLY to WireGuard source IPs (D31/D32). (admin.maat.press)
#   • maat.press        — PUBLIC + CANONICAL. Serves the WHOLE public property: the Analyse surface
#                          (P14 #365) at /analyse* + /card*, and the marketing landing page +
#                          acquisition funnel at everything else. Both surfaces, one host.
#   • www.maat.press    — PUBLIC. A pure alias: 301-redirects every path to the bare apex, so both
#                          surfaces resolve on either host but canonicalise to maat.press.
#
# Caddy runs on the HOST network (see docker-compose.prod.yml) so the `remote_ip` matcher sees
# the real client address — a WireGuard peer arrives as 10.8.0.x; the public internet does not.
# Because Caddy is host-networked it reaches every upstream over the host loopback (NOT compose
# service names): the reader on 127.0.0.1:8000, the marketing site on 127.0.0.1:8080.
# The admin cert is still issued over the public :80 (HTTP-01) — the A record is public, so no
# DNS-01 / OVH-API secret is needed (D32). The SSH tunnel stays as break-glass.

{$MAAT_HOST} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# Everything else on the public host stays private — not reachable from the internet.
	handle {
		respond "Maat — not found" 404
	}
}

{$MAAT_ADMIN_HOST} {
	encode zstd gzip

	# Defence-in-depth layer 1 (network): serve the console only to the WireGuard subnet.
	# (Layer 2 is the Google-OIDC + allowlist gate, shared by both upstreams.) A real LE cert is
	# still presented to everyone; non-WG callers get a 403 instead of the login screen.
	@wg remote_ip {$MAAT_WG_SUBNET:10.8.0.0/24}
	handle @wg {
		# Console v2 cutover (D33/#292): the Next.js console (127.0.0.1:3100) serves the UI; the
		# FastAPI app (127.0.0.1:8000) keeps the OIDC login dance, the command/query API the
		# console + Sia call, the public read API, health, and static assets. Both verify the same
		# `maat_admin` cookie, so routing splits cleanly by path and the cookie rides along.
		@fastapi path /admin/* /admin /api/* /console/api/* /healthz /favicon.ico /static/*
		handle @fastapi {
			reverse_proxy 127.0.0.1:8000
		}
		# Everything else is the Next.js operator console.
		handle {
			reverse_proxy 127.0.0.1:3100
		}
	}
	handle {
		respond "Maat operator console — reachable only over the private network." 403
	}
}

# www.maat.press — a pure alias for the canonical apex. Redirect the WHOLE host (every path,
# both surfaces) to maat.press, preserving the sub-path + query. No content is served here: the
# marketing page and the Analyse surface both live on the apex (below), so www.maat.press/ →
# maat.press/ (marketing) and www.maat.press/analyse → maat.press/analyse (Analyse) — nothing is
# special-cased. This replaces the old split where www served marketing while the apex redirected
# here; the two surfaces disagreed on the canonical host, which is why /analyse only worked on one.
www.maat.press {
	redir https://maat.press{uri} permanent
}

# Apex maat.press — the CANONICAL host for the whole public property, serving both surfaces:
#   • the Analyse surface (P14 #365) at /analyse* + /card* (+ its Next assets and same-origin API)
#   • the marketing landing page + acquisition funnel at everything else (the catch-all handle)
# The Analyse page and its API share this origin so the browser needs no CORS; /api/analyse* is
# rewritten onto the reader's /api/v2/analyse* routes, and SSE must stream unbuffered
# (flush_interval -1). www.maat.press redirects here (above). Caddy is host-networked, so both
# upstreams are reached over the host loopback: the Analyse site on :3200, marketing on :8080.
maat.press {
	encode zstd gzip

	@site path /analyse /analyse/* /card /card/* /_next/* /healthz /favicon.ico /robots.txt
	handle @site {
		reverse_proxy 127.0.0.1:3200
	}

	handle /api/analyse* {
		uri replace /api/analyse /api/v2/analyse
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}

	# Everything else is the marketing landing page + acquisition funnel (the loopback marketing app).
	# It POSTs /track + /notify back to this same origin, so no cross-origin config is needed.
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
